# Firebase Configuration
# Get these values from Firebase Console > Project Settings > Service Account

# Firebase Project ID
FIREBASE_PROJECT_ID=tower-game

# Firebase API Key (public, safe to commit)
FIREBASE_API_KEY=your-api-key-here

# Firebase Auth Domain
FIREBASE_AUTH_DOMAIN=tower-game.firebaseapp.com

# Firebase Database URL
FIREBASE_DATABASE_URL=https://tower-game.firebaseio.com

# Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET=tower-game.appspot.com

# Firebase Messaging Sender ID
FIREBASE_MESSAGING_SENDER_ID=123456789

# Firebase App ID
FIREBASE_APP_ID=1:123456789:web:abc123def456

# RevenueCat API Key (for IAP)
REVENUCAT_API_KEY=your-revenucat-api-key

# RevenueCat Webhook Secret (for signature verification)
REVENUCAT_WEBHOOK_SECRET=your-webhook-secret

# Node Environment
NODE_ENV=production

# CORS allowed origins
CORS_ORIGIN=https://tower-game-3k2.pages.dev,capacitor://localhost

# Backend URL (for frontend to connect to)
FIREBASE_FUNCTIONS_URL=https://us-central1-tower-game.cloudfunctions.net
