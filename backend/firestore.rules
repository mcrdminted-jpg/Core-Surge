rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection - only owner can read/write their own doc
    match /users/{userId} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId;
      allow create: if request.auth.uid == userId;
    }

    // Player saves - subcollection under users
    match /player_saves/{userId}/saves/{saveId} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId;
      allow create: if request.auth.uid == userId;
    }

    // Tournament brackets - public read, admin write only
    match /tournament_brackets/{tournamentId} {
      allow read: if true;  // Public leaderboard
      allow write: if request.auth.token.admin == true;
      allow create: if request.auth.token.admin == true;
    }

    // IAP transactions - owner can read, webhook/admin can write
    match /iap_transactions/{transactionId} {
      allow read: if request.auth.uid == resource.data.userId;
      allow write: if request.auth.token.admin == true;
      allow create: if request.auth.token.admin == true;
    }

    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
